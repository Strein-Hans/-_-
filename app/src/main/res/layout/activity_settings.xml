<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="#1A1A2E"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Accent Selection -->
        <TextView
            android:id="@+id/tvAccentLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/accent"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupAccent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:layout_constraintTop_toBottomOf="@id/tvAccentLabel">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBritish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/british"
                android:checked="true"
                style="@style/Widget.MaterialComponents.Chip.Choice" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAmerican"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/american"
                style="@style/Widget.MaterialComponents.Chip.Choice" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Language Selection -->
        <TextView
            android:id="@+id/tvLanguageLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/language"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/chipGroupAccent" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:layout_constraintTop_toBottomOf="@id/tvLanguageLabel">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEnglish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="English"
                android:checked="true"
                style="@style/Widget.MaterialComponents.Chip.Choice" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipChinese"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中文"
                style="@style/Widget.MaterialComponents.Chip.Choice" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Conversation Mode -->
        <TextView
            android:id="@+id/tvConversationModeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/conversation_mode"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/chipGroupLanguage" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:layout_constraintTop_toBottomOf="@id/tvConversationModeLabel">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTemplate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_template"
                android:checked="true"
                style="@style/Widget.MaterialComponents.Chip.Choice" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLlm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_llm"
                style="@style/Widget.MaterialComponents.Chip.Choice" />
        </com.google.android.material.chip.ChipGroup>

        <!-- ASR Configuration -->
        <TextView
            android:id="@+id/tvAsrLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/asr_config"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/chipGroupMode" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilIflytekAppId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="iFlytek APP_ID"
            app:layout_constraintTop_toBottomOf="@id/tvAsrLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIflytekAppId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilIflytekApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="iFlytek API Key"
            app:layout_constraintTop_toBottomOf="@id/tilIflytekAppId">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIflytekApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- LLM Configuration -->
        <TextView
            android:id="@+id/tvLlmLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/llm_config"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tilIflytekApiKey" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLlmEndpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="API Endpoint"
            app:layout_constraintTop_toBottomOf="@id/tvLlmLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLlmEndpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLlmApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API Key"
            app:layout_constraintTop_toBottomOf="@id/tilLlmEndpoint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLlmApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save"
            android:textAllCaps="false"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilLlmApiKey" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
