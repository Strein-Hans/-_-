<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="com.ielts.coach.IELTSApp"
        android:allowBackup="true"
        android:icon="@mipmap/duix_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DUIX.Display">

        <activity
            android:name="com.ielts.coach.ui.home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.ielts.coach.ui.practice.PracticeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.ielts.coach.ui.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name="com.ielts.coach.ui.report.ReportActivity"
            android:exported="false" />

    </application>

</manifest>
